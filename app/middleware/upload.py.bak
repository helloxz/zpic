from typing import Callable
from app.utils.helper import show_json
from app.middleware.req_limit import rate_upload_limit


async def upload_preflight(request, call_next: Callable,uid:str=""):
    # 定义需要判断的路由数组
    need_check_routes = [
        "/api/user/upload"
    ]
    # 获取请求路径
    path = request.url.path
    # 如果请求路径不在需要判断的路由数组中，则直接放行
    if path not in need_check_routes:
        response = await call_next(request)
        return response
    
    # 接下来对所有上传API进行预处理检查
    # 获取用户ID，优先从参数获取
    if uid == "":
        uid = request.state.uid

    # 如果不存在uid
    rate_limit_1min = await rate_upload_limit(uid,90)  # 每分钟90次
    if not rate_limit_1min:
        return show_json(429,"upload.too.frequent")
    
    from app.api.admin.subscription import SubscriptionHandler
    from app.api.user_config import UserConfigHandler
    
    # 获取用户订阅信息
    subHandler = SubscriptionHandler()
    sub = await subHandler.get_user_subscription(uid)
    if not sub:
        return show_json(-1000,"no.sub")
        
    '''
    没有去重，继续上传流程
    这里限制用户每日和每月上传数量
    '''
    daily_limit = sub.get("daily_limit",0)
    # print(daily_limit)
    monthly_limit = sub.get("monthly_limit",0)
    from app.api.upload import UploadHandler
    upload_handler = UploadHandler()
    limit_ok,limit_msg = await upload_handler.limit_user_upload(uid,daily_limit,monthly_limit)
    if not limit_ok:
        return show_json(-1000, limit_msg)
    # 上传数量限制结束

    # 开始限制用户存储总量
    # 允许的存储总量
    storage_limit_mb = sub.get("storage_limit_mb",0)
    # MB转换为字节
    storage_limit_bytes = storage_limit_mb * 1024 * 1024
    # 获取用户当前存储总量
    user_config = UserConfigHandler()
    user_storage_bytes = await user_config.get_user_storage_bytes(uid)
    # 如果用户当前存储总量大于等于允许的存储总量，则禁止上传
    if user_storage_bytes >= storage_limit_bytes:
        return show_json(-1000,f"storage.quota.limit")

